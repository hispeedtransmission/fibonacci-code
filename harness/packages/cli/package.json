{
  "name": "@fibonacci/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fibonacci": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-core.mjs --profile release",
    "build:dev": "tsup && node scripts/copy-core.mjs --profile debug",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/index.tsx",
    "doctor": "tsx src/index.tsx doctor",
    "showcase": "tsx scripts/showcase.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
